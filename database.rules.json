{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/hostUid').val() === auth.uid",
        "meta": {
          ".write": "auth != null && newData.child('hostUid').val() === auth.uid && (!data.exists() || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostUid', 'status', 'laps'])",
          "title": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'starting'" },
          "laps": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" }
        },
        "seq": { ".validate": "newData.isString() && newData.val().length < 4000" },
        "players": {
          "$lane": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/meta/status').val() === 'lobby') || (data.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "($lane === '0' || $lane === '1' || $lane === '2') && newData.hasChildren(['uid', 'name', 'motor', 'tire'])"
          }
        },
        "spectators": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "roomList": {
      ".read": "auth != null",
      ".indexOn": ["created"],
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['hostUid', 'title', 'status'])",
        "p": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.val() === true"
          }
        }
      }
    }
  }
}
